{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug SITL Flight Engine",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/inav_sitl_debug",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}/build",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "${workspaceFolder}/.vscode/gdb-nodebuginfod.sh",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build inav_sitl_debug"
        }
    ]
}
