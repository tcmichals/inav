{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Pico 2 W - ICM-42688-P Test (Cortex-Debug OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build_pico2w_debug/inav_pico2_imu_test.elf",
            "armToolchainPath": "/home/tcmichals/.tools/gcc-arm-none-eabi/bin",
            "gdbPath": "/home/tcmichals/.tools/gcc-arm-none-eabi/bin/arm-none-eabi-gdb",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2350.cfg"
            ],
            "openOCDPath": "/home/tcmichals/.tools/openocd/bin/openocd",
            "openOCDPreConfigArgs": [
                "-s", "/home/tcmichals/.tools/openocd/openocd/scripts",
                "-c", "adapter speed 5000"
            ],
            "runToEntryPoint": "main",
            "preLaunchTask": "Build Pico 2 W (Debug)"
        },
        {
            "name": "Debug Pico 2 W - Flight Engine (Cortex-Debug OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build_pico2w_debug/inav_abstractx_pico2w.elf",
            "armToolchainPath": "/home/tcmichals/.tools/gcc-arm-none-eabi/bin",
            "gdbPath": "/home/tcmichals/.tools/gcc-arm-none-eabi/bin/arm-none-eabi-gdb",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2350.cfg"
            ],
            "openOCDPath": "/home/tcmichals/.tools/openocd/bin/openocd",
            "openOCDPreConfigArgs": [
                "-s", "/home/tcmichals/.tools/openocd/openocd/scripts",
                "-c", "adapter speed 5000"
            ],
            "runToEntryPoint": "main",
            "preLaunchTask": "Build Pico 2 W (Debug)"
        },
        {
            "name": "Debug Pico 2 W - GDB Remote Port 3333 (cppdbg)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build_pico2w_debug/inav_pico2_imu_test.elf",
            "miDebuggerServerAddress": "localhost:3333",
            "miDebuggerPath": "/home/tcmichals/.tools/gcc-arm-none-eabi/bin/arm-none-eabi-gdb",
            "MIMode": "gdb",
            "cwd": "${workspaceFolder}",
            "setupCommands": [
                {
                    "description": "Enable pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Reset target",
                    "text": "monitor reset init",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Pico 2 W (Debug)"
        },
        {
            "name": "Debug SITL Flight Engine (Host Linux)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/inav_sitl_debug",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}/build",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "${workspaceFolder}/.vscode/gdb-nodebuginfod.sh",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build inav_sitl_debug"
        }
    ]
}
